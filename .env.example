# Copy this file to .env.local and fill in real values locally. Never commit .env.local.
# Everything prefixed with VITE_ is embedded in the public browser bundle:
# only put PUBLIC identifiers here, never server secrets.

# --- Supabase (ADR 0001) ---
# Local stack (ports 553xx: the default 543xx range is often reserved by Windows): run `npx supabase start` and copy the API URL and the publishable (anon) key it prints.
# Staging: Supabase dashboard -> project blood-connect-staging -> Connect / API keys.
# Only the PUBLISHABLE (anon) key belongs here. Never the service_role / secret key.
VITE_SUPABASE_URL="http://127.0.0.1:55321"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_key"
